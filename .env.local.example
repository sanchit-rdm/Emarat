# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-05-25

# Sanity API token — REQUIRED for Visual Editing / Presentation (draft mode)
# and live preview. Create one at https://sanity.io/manage → your project →
# API → Tokens → "Viewer" permission is enough. Either name works:
SANITY_API_READ_TOKEN=your_token_here
# (legacy fallback name, also accepted)
# SANITY_API_TOKEN=your_token_here

# Form submissions (contact, enquiry, careers, callback) — sent via Resend.
# emaratrealty.com is verified as the sending domain in Resend.
RESEND_API_KEY=your_resend_api_key_here
# Must be an address on the verified sending domain in Resend.
FORM_FROM_EMAIL=Emarat Realty Website <forms@emaratrealty.com>
# Comma-separated list of recipients for all form submissions.
FORM_RECIPIENT_EMAILS=info@emaratrealty.com,web@reddashmedia.com
