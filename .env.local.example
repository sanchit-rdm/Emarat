# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-05-25

# Sanity API token — REQUIRED for Visual Editing / Presentation (draft mode)
# and live preview. Create one at https://sanity.io/manage → your project →
# API → Tokens → "Viewer" permission is enough. Either name works:
SANITY_API_READ_TOKEN=your_token_here
# (legacy fallback name, also accepted)
# SANITY_API_TOKEN=your_token_here
